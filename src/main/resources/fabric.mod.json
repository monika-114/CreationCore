{
  "schemaVersion": 1,
  "id": "creationcore",
  "version": "${version}",
  "name": "Creation Core 创造核心",
  "description": "终局生存扩展：创造物质、仪式、创造工作台与创造合成器。",
  "environment": "*",
  "license": "All Rights Reserved",
  "icon": "logo.png",
  "entrypoints": {
    "main": [
      "dev.creationcore.CreativeCoreMod"
    ],
    "client": [
      "dev.creationcore.client.ClientEvents"
    ],
    "jei_mod_plugin": [
      "dev.creationcore.compat.jei.CreationCoreJeiPlugin"
    ]
  },
  "mixins": [
    "creationcore.mixins.json",
    "creationcore.compat.mixins.json"
  ],
  "accessWidener": "creationcore.accesswidener",
  "depends": {
    "fabricloader": ">=0.18.4",
    "minecraft": "1.21.1",
    "java": ">=21",
    "fabric-api": ">=0.114.0+1.21.1"
  },
  "suggests": {
    "jei": "*",
    "toms_storage": "*",
    "sophisticatedbackpacks": "*",
    "sophisticatedstorage": "*"
  }
}